{
  "name": "@ichava/js-icon-components",
  "version": "0.1.0",
  "description": "Generates React, Vue 3, Svelte 5, Web Component, React Native, Angular, SolidJS, Preact, Astro, Qwik, Ember and Elm icon components, plus CSS mask, data URI, PNG, Flutter, SwiftUI and Android VectorDrawable exports, from Ichava icon packs pinned at a git ref.",
  "license": "MIT",
  "author": "Simtabi LLC <ichava@simtabi.com> (https://simtabi.com)",
  "homepage": "https://github.com/ichava/js-icon-components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ichava/js-icon-components.git"
  },
  "bugs": {
    "url": "https://github.com/ichava/js-icon-components/issues"
  },
  "keywords": [
    "ichava",
    "icons",
    "svg",
    "react",
    "vue",
    "svelte",
    "web-components",
    "react-native",
    "angular",
    "solid",
    "preact",
    "astro",
    "qwik",
    "ember",
    "elm",
    "flutter",
    "swiftui",
    "android",
    "vectordrawable"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/shared/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./data/*": {
      "types": "./dist/data/*.d.ts",
      "import": "./dist/data/*.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/*": {
      "types": "./dist/react/packs/*.d.ts",
      "import": "./dist/react/packs/*.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./vue/*": {
      "types": "./dist/vue/packs/*.d.ts",
      "import": "./dist/vue/packs/*.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "import": "./dist/svelte/index.js"
    },
    "./svelte/*.svelte": {
      "types": "./dist/svelte/icon.d.ts",
      "svelte": "./dist/svelte/packs/*.svelte"
    },
    "./svelte/*": {
      "types": "./dist/svelte/packs/*/index.d.ts",
      "svelte": "./dist/svelte/packs/*/index.js",
      "import": "./dist/svelte/packs/*/index.js"
    },
    "./wc": {
      "types": "./dist/wc/index.d.ts",
      "import": "./dist/wc/index.js"
    },
    "./wc/*": {
      "types": "./dist/wc/packs/*.d.ts",
      "import": "./dist/wc/packs/*.js"
    },
    "./react-native": {
      "types": "./dist/react-native/index.d.ts",
      "import": "./dist/react-native/index.js"
    },
    "./react-native/*": {
      "types": "./dist/react-native/packs/*.d.ts",
      "import": "./dist/react-native/packs/*.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "import": "./dist/angular/index.js"
    },
    "./angular/*": {
      "types": "./dist/angular/packs/*.d.ts",
      "import": "./dist/angular/packs/*.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.js"
    },
    "./solid/*": {
      "types": "./dist/solid/packs/*.d.ts",
      "import": "./dist/solid/packs/*.js"
    },
    "./preact": {
      "types": "./dist/preact/index.d.ts",
      "import": "./dist/preact/index.js"
    },
    "./preact/*": {
      "types": "./dist/preact/packs/*.d.ts",
      "import": "./dist/preact/packs/*.js"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "import": "./dist/astro/index.js"
    },
    "./astro/Icon.astro": "./dist/astro/Icon.astro",
    "./astro/*": {
      "types": "./dist/astro/packs/*.d.ts",
      "import": "./dist/astro/packs/*.js"
    },
    "./qwik": {
      "types": "./dist/qwik/index.d.ts",
      "import": "./dist/qwik/index.js"
    },
    "./qwik/*": {
      "types": "./dist/qwik/packs/*.d.ts",
      "import": "./dist/qwik/packs/*.js"
    },
    "./ember": {
      "types": "./dist/ember/index.d.ts",
      "import": "./dist/ember/index.js"
    },
    "./ember/*": {
      "types": "./dist/ember/packs/*.d.ts",
      "import": "./dist/ember/packs/*.js"
    },
    "./elm/*": "./dist/elm/*",
    "./assets/*": "./dist/assets/*",
    "./manifest.json": "./dist/manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@angular/core": ">=20",
    "@builder.io/qwik": ">=1.5.0",
    "astro": ">=5.0.0",
    "ember-source": ">=6.3.0",
    "preact": ">=10.19.0",
    "react": ">=18",
    "react-native-svg": ">=15",
    "solid-js": "^1.8.0",
    "svelte": "^5.0.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@builder.io/qwik": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "ember-source": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && ngc -p tsconfig.angular.json && node dist/generator/cli.js",
    "generate": "node dist/generator/cli.js",
    "prepare": "node scripts/prepare.mjs",
    "typecheck": "tsc -p tsconfig.json && ngc -p tsconfig.angular.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:config-drift": "node config/check-config-drift.mjs config/tsconfig.base.json=config/tsconfig.base.json config/eslint.base.js=config/eslint.base.js config/check-config-drift.mjs=config/check-config-drift.mjs"
  },
  "devDependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@astrojs/compiler-rs": "^0.5.2",
    "@builder.io/qwik": "^1.20.3",
    "@eslint/js": "^10.0.1",
    "@glimmer/compiler": "^0.94.11",
    "@glimmer/env": "^0.1.7",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "astro": "^7.4.5",
    "content-tag": "^4.2.1",
    "elm": "^0.19.1-6",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "fast-xml-parser": "^5.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "preact": "^11.1.1",
    "preact-render-to-string": "^6.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-svg": "^15.16.0",
    "rxjs": "^7.8.2",
    "solid-js": "^1.9.18",
    "svelte": "^5.57.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.3",
    "vue": "^3.5.44",
    "yaml": "^2.9.1"
  }
}
